rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public dashboard: any visitor can anonymously authenticate and manage records.
    // WARNING: anyone who can reach the site can read, create, update, and delete dc_cases.
    match /dc_cases/{caseId} {
      allow read, create, update, delete: if request.auth != null;
    }

    match /settings/{settingId} {
      allow read, write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
